# Copy to .env and fill in. docker compose reads .env from this directory.

# Required: the password you log in with.
LEVET_PASSWORD=

# Optional. The port the app is published on (default 8000).
#LEVET_PORT=8000

# Optional. Which version to keep of an exam printed in several languages,
# until you change it on the Settings page: nb, nn or en (default nb).
#LEVET_LANGUAGE=nb

# Optional. Signs the login cookie. Leave unset and a key is generated once
# and kept in the data volume.
#LEVET_SECRET_KEY=
